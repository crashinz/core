+    }
+    CC_READY = 1; return 1;
+}
+EMSCRIPTEN_KEEPALIVE
+int wasm_context_add(unsigned long long p1,unsigned long long p2,unsigned long long p1k,unsigned long long p2k,int player,int count){
+    if (!CC_READY || CC_HISTORY_LEN >= CC_HISTORY_MAX || player < 1 || player > 2 || count < 1 || count > 1000000){CC_READY=0;return 0;}
+    CC_HISTORY[CC_HISTORY_LEN++] = (struct cc_position){p1,p2,p1k,p2k,player,count};
+    return 1;
+}
