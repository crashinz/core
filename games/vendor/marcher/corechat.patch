+// CoreChat isolated Marcher candidate, 2026-09-14. MIT, like the parent engine.
+// Exact saved positions plus the active search line; no hash-table collisions.
+// Search is limited to depth 50 at the WASM boundary (engine's absolute cap).
+#define CC_HISTORY_MAX 256
+struct cc_position { unsigned long long p1,p2,p1k,p2k; int player,count; };
+static struct cc_position CC_HISTORY[CC_HISTORY_MAX], CC_LINE[128];
+static int CC_HISTORY_LEN, CC_ACTIVE, CC_READY, CC_AUTOMATIC, CC_QUIET[128];
+static int cc_matches(struct cc_position* p,unsigned long long a,unsigned long long b,unsigned long long c,unsigned long long d,int player){
+    return p->player==player && p->p1==a && p->p2==b && p->p1k==c && p->p2k==d;
+}
+static int cc_occurrences(unsigned long long a,unsigned long long b,unsigned long long c,unsigned long long d,int player,int ply){
+    int count=0;
+    for(int i=0;i<CC_HISTORY_LEN;i++) if(cc_matches(&CC_HISTORY[i],a,b,c,d,player)) count+=CC_HISTORY[i].count;
+    // Root is already in saved counts. Intermediate jumps never count as turns.
+    for(int i=1;i<=ply;i++) if(CC_LINE[i].count && cc_matches(&CC_LINE[i],a,b,c,d,player)) count++;
+    return count;
+}
