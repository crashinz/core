+// CoreChat optional-rule candidate. MIT, like Marcher. Included by wasm_api.c.
+// Standard Marcher search is retained when the rule mask is zero. The variant
+// path uses explicit captured squares and a full-width alpha-beta search: the
+// standard-trained network, opening book and tablebase are not variant oracles.
+#define CCV_MAX_MOVES (32 * 4 * 7)
+#define CCV_MAX_PLY 96
+#define CCV_WIN 30000
+typedef struct { unsigned char board[64]; int side,forced,quiet; } ccv_board;
+typedef struct { int from,to,capture; } ccv_move;
+static int CC_RULES;
+static int32_t CCV_EXPORT[CCV_MAX_MOVES * 3 + 80];
+static unsigned long long CCV_NODES, CCV_EVALS;
+static int CCV_ABORT,CCV_MAX_REACHED;
+static double CCV_DEADLINE;
+
+static int ccv_side(int p){return p ? ((p==1 || p==3)?1:2) : 0;}
+static ccv_board ccv_unpack(unsigned long long a,unsigned long long b,unsigned long long c,unsigned long long d,int side,int forced,int quiet){
+    ccv_board s={{0},side,forced,quiet};
+    for(int i=0;i<64;i++)s.board[i]=(a>>i&1)?1:(b>>i&1)?2:(c>>i&1)?3:(d>>i&1)?4:0;
+    return s;
+}
+static struct cc_position ccv_pack(const ccv_board* s,int count){
+    struct cc_position p={0,0,0,0,s->side,count};
+    for(int i=0;i<64;i++)switch(s->board[i]){
+        case 1:p.p1|=1ull<<i;break; case 2:p.p2|=1ull<<i;break;
+        case 3:p.p1k|=1ull<<i;break; case 4:p.p2k|=1ull<<i;break;
+    }
+    return p;
+}
+static int ccv_valid(unsigned long long a,unsigned long long b,unsigned long long c,unsigned long long d,int side,int forced,int rules){
+    const unsigned long long dark=0x55aa55aa55aa55aaull;
+    unsigned long long all=a|b|c|d;
+    return side>=1 && side<=2 && forced>=-1 && forced<64 && rules>=0 && rules<=7
+        && !(all&~dark) && !(a&b) && !(a&c) && !(a&d) && !(b&c) && !(b&d) && !(c&d)
+        && __builtin_popcountll(a|c)<=12 && __builtin_popcountll(b|d)<=12
+        && (forced<0 || (((side==1)?(a|c):(b|d))>>forced&1));
+}
+// Captures and quiet steps are deliberately generated in separate passes.
+// A capture anywhere suppresses every quiet move; a forced continuation stays
+// on exactly one piece. Long king captures may land on EACH empty square after
+// the first enemy, but never cross a second piece.
+static int ccv_piece(const ccv_board* s,int from,int captures,int rules,ccv_move* out){
+    int p=s->board[from],n=0,side=ccv_side(p),king=p>2;
+    int flying=king&&(rules&4),back=king||(rules&(captures?2:1));
+    if(!p)return 0;
+    for(int dr=-1;dr<=1;dr+=2)for(int dc=-1;dc<=1;dc+=2){
+        if(!back && dr!=(side==1?-1:1))continue;
+        int enemy=-1,limit=flying?7:(captures?2:1);
+        for(int step=1;step<=limit;step++){
+            int r=from/8+dr*step,c=from%8+dc*step;
+            if(r<0||r>7||c<0||c>7)break;
+            int to=r*8+c,target=s->board[to];
+            if(!captures){
+                if(target)break;
+                out[n++]=(ccv_move){from,to,-1};
+            }else if(target){
+                if(ccv_side(target)==side || enemy>=0)break;
+                enemy=to;
+            }else if(enemy>=0){
+                out[n++]=(ccv_move){from,to,enemy};
+            }else if(!flying)break;
+        }
+    }
+    return n;
+}
+static int ccv_moves(const ccv_board* s,int rules,ccv_move* out){
+    if(s->forced>=0)return ccv_piece(s,s->forced,1,rules,out);
+    int n=0;
+    for(int i=0;i<64;i++)if(ccv_side(s->board[i])==s->side)n+=ccv_piece(s,i,1,rules,out+n);
+    if(n)return n;
+    for(int i=0;i<64;i++)if(ccv_side(s->board[i])==s->side)n+=ccv_piece(s,i,0,rules,out+n);
+    return n;
+}
+static ccv_board ccv_apply(const ccv_board* s,ccv_move m,int rules){
+    ccv_board t=*s; int piece=s->board[m.from],promoted=0;
+    t.board[m.from]=0;t.board[m.to]=piece;
+    if(m.capture>=0)t.board[m.capture]=0;
+    if((piece==1&&m.to<8)||(piece==2&&m.to>55)){t.board[m.to]=piece+2;promoted=1;}
+    t.quiet=(m.capture>=0||piece<=2)?0:s->quiet+1;
+    t.forced=-1;
+    if(m.capture>=0&&!promoted){
+        ccv_move more[28];
+        if(ccv_piece(&t,m.to,1,rules,more)){t.forced=m.to;return t;}
+    }
+    t.side^=3;return t;
+}
+static void ccv_line(const ccv_board* t,int ply){CC_LINE[ply]=ccv_pack(t,t->forced<0?1:0);}
+static int ccv_draw(const ccv_board* s,int ply){
+    if(!CC_AUTOMATIC||s->forced>=0)return 0;
+    if(s->quiet>=80)return 1;
+    struct cc_position p=ccv_pack(s,0);
+    return cc_occurrences(p.p1,p.p2,p.p1k,p.p2k,p.player,ply)>=3;
+}
+static int ccv_eval(const ccv_board* s,int rules){
+    int value=0;
+    for(int i=0;i<64;i++)if(s->board[i]){
+        int p=s->board[i],side=ccv_side(p),r=i/8,c=i%8;
+        int central=6-abs(2*r-7)/2-abs(2*c-7)/2;
+        int v=p>2?((rules&4)?280:190)+central*3:100+((side==1?7-r:r)*5)+central;
+        value+=(side==s->side)?v:-v;
+    }
+    CCV_EVALS++;return value;
+}
+static int ccv_priority(const ccv_board* s,ccv_move m,int preferred){
+    if(((m.from<<8)|m.to)==preferred)return 100000;
+    return (m.capture<0?0:(s->board[m.capture]>2?400:200))
+        +((s->board[m.from]==1&&m.to<8)||(s->board[m.from]==2&&m.to>55)?150:0);
+}
+static void ccv_order(const ccv_board* s,ccv_move* moves,int n,int preferred){
+    // Stable insertion sort preserves deterministic ties across scalar/SIMD.
+    for(int i=1;i<n;i++){
+        ccv_move m=moves[i];int v=ccv_priority(s,m,preferred),j=i;
+        while(j>0&&ccv_priority(s,moves[j-1],preferred)<v){moves[j]=moves[j-1];j--;}
+        moves[j]=m;
+    }
+}
+static int ccv_expired(void){if(emscripten_get_now()>=CCV_DEADLINE)CCV_ABORT=1;return CCV_ABORT;}
+static int ccv_search_node(const ccv_board* s,int rules,int depth,int ply,int alpha,int beta){
+    CCV_NODES++;if(ply>CCV_MAX_REACHED)CCV_MAX_REACHED=ply;
+    if((CCV_NODES&63)==0&&ccv_expired())return 0;
+    ccv_move moves[CCV_MAX_MOVES];int n=ccv_moves(s,rules,moves);
+    // Loss has precedence over automatic draw, matching the server reducer.
+    if(!n)return -CCV_WIN+ply;
+    if(ccv_draw(s,ply))return 0;
+    // At nominal depth, extend compulsory captures until the position is quiet.
+    if(ply>=CCV_MAX_PLY || (depth<=0&&moves[0].capture<0))return ccv_eval(s,rules);
+    ccv_order(s,moves,n,-1);
+    int best=-CCV_WIN-1;
+    for(int i=0;i<n;i++){
+        ccv_board t=ccv_apply(s,moves[i],rules);ccv_line(&t,ply+1);
+        int v=t.side==s->side?ccv_search_node(&t,rules,depth-1,ply+1,alpha,beta)
+            :-ccv_search_node(&t,rules,depth-1,ply+1,-beta,-alpha);
+        if(CCV_ABORT)return 0;
+        if(v>best)best=v;if(v>alpha)alpha=v;if(alpha>=beta)break;
+    }
+    return best;
+}
+static int ccv_search(ccv_board s,int rules,double seconds,int depth){
+    CCV_NODES=CCV_EVALS=0;CCV_ABORT=CCV_MAX_REACHED=0;CCV_DEADLINE=emscripten_get_now()+seconds*1000;
+    ccv_move moves[CCV_MAX_MOVES];int n=ccv_moves(&s,rules,moves);
+    memset(WASM_RESULT,0,sizeof(WASM_RESULT));
+    if(!n||ccv_draw(&s,0)){WASM_RESULT[0]=WASM_RESULT[1]=-1;return -1;}
+    ccv_order(&s,moves,n,-1);
+    int best=(moves[0].from<<8)|moves[0].to,bestScore=0,done=0;
+    for(int d=1;d<=depth;d++){
+        ccv_order(&s,moves,n,best);int iterationBest=best,score=-CCV_WIN-1;
+        for(int i=0;i<n;i++){
+            if(ccv_expired())break;
+            ccv_board t=ccv_apply(&s,moves[i],rules);ccv_line(&t,1);
+            int v=t.side==s.side?ccv_search_node(&t,rules,d-1,1,score,CCV_WIN+1)
+                :-ccv_search_node(&t,rules,d-1,1,-CCV_WIN-1,-score);
+            if(CCV_ABORT)break;
+            if(v>score){score=v;iterationBest=(moves[i].from<<8)|moves[i].to;}
+        }
+        if(CCV_ABORT)break;
+        best=iterationBest;bestScore=score;done=d;
+        if(abs(score)>CCV_WIN-CCV_MAX_PLY)break;
+    }
+    WASM_RESULT[0]=best>>8;WASM_RESULT[1]=best&255;WASM_RESULT[2]=bestScore;WASM_RESULT[3]=done;
+    WASM_RESULT[4]=CCV_MAX_REACHED;WASM_RESULT[5]=(int32_t)CCV_NODES;WASM_RESULT[6]=(int32_t)(CCV_NODES>>32);
+    WASM_RESULT[9]=(int32_t)CCV_EVALS;WASM_RESULT[10]=(int32_t)(CCV_EVALS>>32);WASM_RESULT[11]=CCV_MAX_REACHED;
+    return best;
+}
+EMSCRIPTEN_KEEPALIVE int wasm_variant_configure(int rules){
+    if(!CC_READY||rules<0||rules>7){CC_READY=0;return 0;}CC_RULES=rules;return 1;
+}
+EMSCRIPTEN_KEEPALIVE int32_t* wasm_variant_result_ptr(void){return CCV_EXPORT;}
+EMSCRIPTEN_KEEPALIVE int wasm_variant_moves(unsigned long long a,unsigned long long b,unsigned long long c,unsigned long long d,int side,int forced,int rules){
+    if(!ccv_valid(a,b,c,d,side,forced,rules))return -1;
+    ccv_board s=ccv_unpack(a,b,c,d,side,forced,0);ccv_move moves[CCV_MAX_MOVES];int n=ccv_moves(&s,rules,moves);
+    for(int i=0;i<n;i++){CCV_EXPORT[i*3]=moves[i].from;CCV_EXPORT[i*3+1]=moves[i].to;CCV_EXPORT[i*3+2]=moves[i].capture;}
+    return n;
+}
+EMSCRIPTEN_KEEPALIVE int wasm_variant_step(unsigned long long a,unsigned long long b,unsigned long long c,unsigned long long d,int side,int forced,int rules,int quiet,int from,int to){
+    if(!ccv_valid(a,b,c,d,side,forced,rules)||quiet<0||quiet>1000000)return -1;
+    ccv_board s=ccv_unpack(a,b,c,d,side,forced,quiet);ccv_move moves[CCV_MAX_MOVES];int n=ccv_moves(&s,rules,moves);
+    for(int i=0;i<n;i++)if(moves[i].from==from&&moves[i].to==to){
+        ccv_board t=ccv_apply(&s,moves[i],rules);ccv_line(&t,1);
+        for(int sq=0;sq<64;sq++)CCV_EXPORT[sq]=t.board[sq];
+        CCV_EXPORT[64]=t.side;CCV_EXPORT[65]=t.forced;CCV_EXPORT[66]=t.quiet;
+        int next=ccv_moves(&t,rules,moves);CCV_EXPORT[67]=!next?2:ccv_draw(&t,1)?1:0;return 1;
+    }
+    return -1;
+}
+static double ccv_perft(const ccv_board* s,int rules,int depth){
+    if(!depth)return 1;
+    ccv_move moves[CCV_MAX_MOVES];int n=ccv_moves(s,rules,moves);double total=0;
+    for(int i=0;i<n;i++){ccv_board t=ccv_apply(s,moves[i],rules);total+=ccv_perft(&t,rules,depth-1);}return total;
+}
+EMSCRIPTEN_KEEPALIVE double wasm_variant_perft(unsigned long long a,unsigned long long b,unsigned long long c,unsigned long long d,int side,int forced,int rules,int depth){
+    if(!ccv_valid(a,b,c,d,side,forced,rules)||depth<0||depth>5)return -1;
