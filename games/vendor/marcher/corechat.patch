+// CoreChat host imports complete authoritative counts, without replaying searches.
+EMSCRIPTEN_KEEPALIVE
+int wasm_context_reset(int automatic, int quiet){
+    CC_RULES = 0;
+    CC_READY = 0;
+    if ((automatic != 0 && automatic != 1) || quiet < 0 || quiet > 1000000) return 0;
+    CC_ACTIVE = 1; CC_AUTOMATIC = automatic; CC_HISTORY_LEN = 0;
+    memset(CC_LINE,0,sizeof(CC_LINE)); memset(CC_QUIET,0,sizeof(CC_QUIET));
+    CC_QUIET[0] = quiet;
+    GAME_HISTORY_LEN = 0; LAST_TOTAL_PIECES = 0;
+    // Keep move ordering/static eval reuse within this search, but never carry it
+    // across reconnects or games. Draw-dependent TT score cutoffs are disabled.
+    if (GLOBAL_HASH_TABLE){
+        memset(GLOBAL_HASH_TABLE->table,0,GLOBAL_HASH_TABLE->total_size*sizeof(struct hash_table_entry));
