{
  "schema": "chatspace.first-party-extension",
  "schemaVersion": 1,
  "id": "space-invasion",
  "name": "Space Invasion",
  "version": "1.0.5",
  "repositoryOwned": true,
  "trustedFirstParty": true,
  "compatibility": {
    "applicationVersionPrefix": "ChatSpace Community Edition v1."
  },
  "dependencies": [],
  "conflicts": [],
  "capabilities": [
    "game.registry.describe",
    "game.session.use",
    "game.rules.authoritative",
    "game.presentation.pack",
    "game.rules.help"
  ],
  "subscriptions": [
    "presentation.games"
  ],
  "services": [
    "game.registry.projection",
    "game.framework.sessions",
    "game.rules.authoritative"
  ],
  "storage": {
    "schemaVersion": 1,
    "quotaBytes": 65536,
    "uninstallPolicy": "explicit-cleanup-only",
    "disablePolicy": "preserve"
  },
  "game": {
    "key": "g_b64p3_space",
    "name": "Space Invasion",
    "displayNameSettingKey": "multiplayer_game_display_name_spaceinvasion",
    "gameId": 106,
    "path": "space-invasion-first-party",
    "entry": "index.html",
    "icon": "spaceinvasion-icon.png",
    "profile": "one-player",
    "minPlayers": 1,
    "practiceMinPlayers": 1,
    "recordedMinPlayers": 1,
    "maxPlayers": 2,
    "seats": [
      "Player 1",
      "Player 2"
    ],
    "adaptationVersion": "1.0.0",
    "presentationSelectionOwner": "viewer",
    "defaultPresentationPack": "built-in",
    "presentationPacks": [
      {
        "label": "Built-in",
        "id": "built-in"
      }
    ],
    "scoreRecordsSurface": {
      "label": "Score & Records",
      "presentationOnly": true,
      "separate": true
    },
    "presentationSizing": {
      "minimumReadableWidth": 480,
      "preferredAspectRatio": 1.5,
      "minimumReadableHeight": 320
    },
    "rulesHelp": {
      "description": "Original arcade rules, with server-owned gameplay and shared lifecycle controls.",
      "label": "Space Invasion rules"
    }
  },
  "requiredFiles": [
    "includes/arcade_extension_support.php",
    "includes/space_arcade_extension.php",
    "games/space-invasion-first-party/index.html",
    "games/arcade-first-party/app.js",
    "games/arcade-first-party/style.css",
    "games/ocx-extension-game.js",
    "games/ocx-extension-game.css",
    "games/classic-source-maps.js",
    "games/viewport-height-fit.js",
    "assets/images/spaceinvasion-icon.png",
    "games/spaceinvasion/enemy.png",
    "games/spaceinvasion/player1.png",
    "games/arcade-first-party/space-view.js",
    "games/arcade-first-party/space-simulation.js",
    "games/arcade-first-party/space-frame-client.js",
    "includes/space_arcade_frame_input.php",
    "games/arcade-first-party/tetris-view.js",
    "includes/space_arcade_coop.php",
    "games/spaceinvasion/player2.png",
    "games/game-avatar.js",
    "games/classic-game-audio.js",
    "games/game-view-storage.js",
    "games/bot-pacing.js",
    "games/bot-avatar-options.js",
    "includes/game_bot_avatars.php",
    "api/game_bot_avatars.php"
  ]
}
