{
  "schema": "chatspace.first-party-extension",
  "schemaVersion": 1,
  "id": "gesture-maker",
  "name": "Gesture Maker",
  "version": "1.0.1",
  "repositoryOwned": true,
  "trustedFirstParty": true,
  "compatibility": {
    "applicationVersionPrefix": "ChatSpace Community Edition v1."
  },
  "dependencies": [],
  "conflicts": [],
  "capabilities": [
    "gesture.catalog.read",
    "gesture.editor.command",
    "gesture.package.import",
    "gesture.package.export",
    "gesture.preview",
    "gesture.protected-media.reference",
    "presentation.gesture-maker"
  ],
  "subscriptions": [
    "presentation.gesture-management",
    "presentation.gesture-editor",
    "presentation.gesture-preview",
    "presentation.gesture-package"
  ],
  "services": [
    "gesture.catalog.projection",
    "gesture.editor.commands",
    "gesture.package.import",
    "gesture.package.export",
    "gesture.preview.references",
    "gesture.protected-media.references"
  ],
  "storage": {
    "schemaVersion": 1,
    "quotaBytes": 65536,
    "disablePolicy": "preserve",
    "uninstallPolicy": "explicit-cleanup-only"
  },
  "requiredFiles": [
    "includes/gesture_maker_extension.php",
    "extensions/gesture-maker/assets/gesture-editor.css",
    "extensions/gesture-maker/assets/gesture-editor.js",
    "extensions/gesture-maker/assets/gesture-editor-state.js"
  ]
}
