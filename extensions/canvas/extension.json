{
  "schema": "chatspace.first-party-extension",
  "schemaVersion": 1,
  "id": "canvas",
  "name": "Canvas",
  "version": "1.0.2",
  "repositoryOwned": true,
  "trustedFirstParty": true,
  "compatibility": {
    "applicationVersionPrefix": "ChatSpace Community Edition v1."
  },
  "dependencies": [],
  "conflicts": [],
  "capabilities": [
    "canvas.document.read",
    "canvas.document.write",
    "canvas.comment",
    "canvas.manage",
    "canvas.publish",
    "presentation.canvas"
  ],
  "subscriptions": [
    "presentation.canvas"
  ],
  "services": [
    "canvas.document.projection",
    "canvas.document.commands",
    "canvas.comment.commands",
    "canvas.permissions",
    "canvas.publish"
  ],
  "storage": {
    "schemaVersion": 1,
    "quotaBytes": 65536,
    "disablePolicy": "preserve",
    "uninstallPolicy": "explicit-cleanup-only"
  },
  "requiredFiles": [
    "includes/canvas_extension.php",
    "api/canvas.php",
    "extensions/canvas/assets/canvas.css",
    "extensions/canvas/assets/canvas.js"
  ]
}
